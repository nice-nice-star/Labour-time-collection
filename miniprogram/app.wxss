/* miniprogram/app.wxss */
page {
  background: #f5f6fa;
  font-size: 28rpx;
  color: #1a202c;
  -webkit-font-smoothing: antialiased;
}

.btn-primary {
  background: #2b6cb0;
  color: #fff;
  border-radius: 12rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, .06);
}

.form-label {
  display: block;
  font-weight: bold;
  margin: 32rpx 0 16rpx;
}
