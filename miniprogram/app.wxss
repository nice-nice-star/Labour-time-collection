page { background: #f3f6f8; color: #203449; font-size: 28rpx; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; line-height: 1.6; }
.page { padding: 40rpx 32rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.eyebrow { display: block; color: #64808c; font-size: 21rpx; font-weight: 600; letter-spacing: 4rpx; }
.page-title { display: block; font-size: 46rpx; font-weight: 700; margin-top: 10rpx; }
.page-desc { display: block; color: #71818e; font-size: 25rpx; margin-top: 12rpx; }
.page-heading { margin-bottom: 36rpx; }
.card { background: #fff; border: 1rpx solid #e6edf0; border-radius: 24rpx; padding: 32rpx; margin-bottom: 24rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.section-title { font-size: 31rpx; font-weight: 600; }
.section-index { color: #0c877f; background: #e9f6f3; border-radius: 10rpx; font-size: 22rpx; padding: 4rpx 12rpx; margin-right: 14rpx; }
.form-label { display: block; font-size: 27rpx; font-weight: 600; margin: 28rpx 0 14rpx; }
.field-first { margin-top: 0; }
.input, .picker, .textarea { background: #f7f9fb; border: 2rpx solid #e6edf0; border-radius: 14rpx; padding: 22rpx 24rpx; font-size: 28rpx; }
.input { height: 44rpx; line-height: 44rpx; }
.textarea { width: 100%; box-sizing: border-box; height: 200rpx; line-height: 1.7; }
.picker { display: flex; align-items: center; justify-content: space-between; min-height: 44rpx; }
.placeholder { color: #8a98a5; }
.chevron { color: #8194a2; font-size: 36rpx; margin-left: 16rpx; }
.helper { display: block; font-size: 23rpx; color: #7a8995; margin-top: 12rpx; }
button { font-size: 28rpx; font-weight: 600; border-radius: 16rpx; }
button::after { border: none; }
button.btn-primary { background: #11877f; color: #fff; line-height: 1.5; padding: 26rpx 24rpx; }
button.btn-secondary { background: #eaf3f3; color: #147a75; line-height: 1.5; padding: 24rpx; }
button.btn-primary[disabled], button.btn-secondary[disabled] { background: #e4ebed; color: #91a0a7; }
.tap-feedback { opacity: .75; }
.badge { display: inline-block; font-size: 22rpx; padding: 5rpx 16rpx; border-radius: 100rpx; color: #0e8077; background: #e8f6f0; }
.badge-muted { color: #73808b; background: #edf1f4; }
.notice { background: #eaf3f5; color: #526f80; padding: 24rpx; border-radius: 16rpx; font-size: 24rpx; margin-bottom: 24rpx; }
.state-card { text-align: center; padding: 64rpx 32rpx; }
.state-title { display: block; font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.state-card button { margin-top: 32rpx; }
.footer-note { display: block; text-align: center; color: #8b99a4; font-size: 22rpx; margin-top: 40rpx; letter-spacing: 2rpx; }
