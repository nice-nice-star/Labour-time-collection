.splash { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 90vh; padding: 0 40rpx; }
/* 启动页标记：CPRO 字样 logo（透明底），高度由 widthFix 按原图比例算 */
.splash-mark { display: block; width: 360rpx; margin-bottom: 40rpx; }
.title { font-size: 44rpx; font-weight: 600; margin-top: 20rpx; }
.sub { color: #7a8b96; font-size: 26rpx; margin-top: 12rpx; }
.login-state { margin-top: 72rpx; text-align: center; }
.login-state button { margin-top: 24rpx; }
.loading-dot { margin: 0 auto 24rpx; width: 14rpx; height: 14rpx; border-radius: 50%; background: #16877a; animation: pulse 1.4s ease-in-out infinite; }
@keyframes pulse { 0%, 100% { opacity: .3; transform: scale(.8); } 50% { opacity: 1; transform: scale(1.2); } }
