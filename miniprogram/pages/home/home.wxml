<view class="page home">
  <view class="brand-row"><text class="eyebrow">CPRO / WORKSPACE</text><view class="home-controls"><text class="date-label">{{currentMonth}}</text><button wx:if="{{role === 'student'}}" class="language-toggle" bindtap="toggleLanguage" aria-label="{{t.switchLabel}}">{{language === 'zh' ? 'English' : '中文'}}</button></view></view>
  <view class="welcome"><text class="page-title">{{t.greeting}}{{user.name || t.teacher}}</text><text class="page-desc">{{t.welcome}}</text></view>
  <view class="profile"><view class="avatar">{{avatarText}}</view><view class="profile-info"><text class="profile-name">{{user.name || t.admin}}</text><text class="profile-id">{{user.studentId ? t.studentId + user.studentId : t.management}}</text></view><text class="badge">{{role === 'export' ? t.teacherRole : (user.isSupervisor ? t.supervisor : t.student)}}</text></view>
  <!-- 学助专属：填报入口（对老师隐藏） -->
  <view wx:if="{{role !== 'export'}}" class="entry-card" bindtap="go" data-url="/pages/form/form" hover-class="tap-feedback" role="button" aria-label="{{t.reportLabel}}">
    <view class="entry-top"><text class="entry-kicker">MONTHLY REPORT</text><view class="entry-symbol">↗</view></view>
    <text class="entry-title">{{t.reportTitle}}</text><text class="entry-description">{{t.reportDescription}}</text>
    <view class="entry-bottom"><text>{{t.reportAction}}</text><text class="entry-arrow">→</text></view>
  </view>
  <!-- 老师专属：填报情况入口（对学生隐藏） -->
  <view wx:if="{{role === 'export'}}" class="entry-card" bindtap="go" data-url="/pages/submissions/submissions" hover-class="tap-feedback" role="button" aria-label="查看填报情况">
    <view class="entry-top"><text class="entry-kicker">SUBMISSION STATUS</text><view class="entry-symbol">☰</view></view>
    <text class="entry-title">了解本月填报进度</text><text class="entry-description">查看谁已填报，以及每人的有效工时。</text>
    <view class="entry-bottom"><text>查看填报情况</text><text class="entry-arrow">→</text></view>
  </view>
  <block wx:if="{{role === 'export'}}">
    <view class="section-heading tools-heading"><text class="section-title">管理工作台</text><text class="helper">月度统计与归档</text></view>
    <view class="tool-grid">
      <view class="tool-card" bindtap="go" data-url="/pages/form-create/form-create" hover-class="tap-feedback" role="button"><view class="tool-icon">＋</view><text class="tool-title">创建月度表单</text><text class="tool-desc">设置月份与截止日期</text><text class="tool-link">前往设置 →</text></view>
      <view class="tool-card" bindtap="go" data-url="/pages/export/export" hover-class="tap-feedback" role="button"><view class="tool-icon blue">↓</view><text class="tool-title">统计与导出</text><text class="tool-desc">汇总工时，导出 Excel</text><text class="tool-link">查看数据 →</text></view>
    </view>
  </block>
  <view wx:if="{{role !== 'export'}}" class="card guide"><text class="section-title">{{t.guide}}</text><view class="guide-row"><text class="guide-dot">01</text><text>{{t.tip1}}</text></view><view class="guide-row"><text class="guide-dot">02</text><text>{{t.tip2}}</text></view></view>
  <button class="logout" bindtap="logout">{{t.logout}}</button>
  <text class="footer-note">{{t.footer}}</text>
</view>
