.brand-row { display: flex; justify-content: space-between; align-items: center; }
.date-label { color: #748593; font-size: 23rpx; }
.brand-row { flex-wrap: wrap; gap: 16rpx; }
.home-controls { display: flex; align-items: center; gap: 16rpx; margin-left: auto; }
.language-toggle { margin: 0; padding: 0 20rpx; min-height: 64rpx; line-height: 64rpx; font-size: 24rpx; color: #157d74; background: #e8f6f0; border-radius: 18rpx; }
.language-toggle::after { border: none; }
.profile .badge { max-width: 210rpx; white-space: normal; text-align: center; }
.avatar { flex-shrink: 0; }
.welcome { margin: 30rpx 0; }
.profile { display: flex; align-items: center; margin-bottom: 36rpx; }
.avatar { width: 76rpx; height: 76rpx; background: #dcece9; color: #157d74; border-radius: 24rpx; text-align: center; line-height: 76rpx; font-weight: 600; font-size: 32rpx; }
.profile-info { flex: 1; min-width: 0; padding: 0 20rpx; }
.profile-name { display: block; font-size: 27rpx; font-weight: 600; }
.profile-id { display: block; color: #81909c; font-size: 22rpx; word-break: break-all; }
.entry-card { padding: 36rpx; background: linear-gradient(125deg, #17384b, #16645f); color: #fff; border-radius: 28rpx; box-shadow: 0 14rpx 32rpx rgba(25, 69, 76, .13); }
.entry-top { display: flex; justify-content: space-between; align-items: center; }
.entry-kicker { font-size: 20rpx; letter-spacing: 3rpx; color: #b6d9d5; }
.entry-symbol { width: 60rpx; height: 60rpx; border: 1rpx solid #719d9c; border-radius: 50%; text-align: center; line-height: 60rpx; font-size: 36rpx; }
.entry-title { display: block; font-size: 40rpx; font-weight: 600; margin: 24rpx 0 12rpx; }
.entry-description { display: block; color: #c5dcdf; font-size: 25rpx; }
.entry-bottom { display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid rgba(255,255,255,.18); margin-top: 36rpx; padding-top: 24rpx; font-weight: 600; }
.entry-arrow { font-size: 36rpx; }
.tools-heading { margin-top: 40rpx; }
.tools-heading .helper { margin: 0; }
.tool-grid { display: flex; justify-content: space-between; margin-bottom: 24rpx; }
.tool-card { width: 48%; box-sizing: border-box; padding: 28rpx 24rpx; background: #fff; border: 1rpx solid #e6edf0; border-radius: 24rpx; }
.tool-icon { background: #e8f6f0; color: #16877a; border-radius: 14rpx; width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; font-size: 40rpx; margin-bottom: 24rpx; }
.tool-icon.blue { background: #edf1fa; color: #536d9b; }
.tool-title, .tool-desc, .tool-link { display: block; }
.tool-title { font-size: 28rpx; font-weight: 600; }
.tool-desc { color: #82909a; font-size: 22rpx; margin-top: 10rpx; }
.tool-link { color: #16877a; font-size: 23rpx; margin-top: 28rpx; }
.guide { margin-top: 32rpx; }
.guide-row { display: flex; align-items: baseline; color: #71818e; font-size: 24rpx; margin-top: 20rpx; }
.guide-dot { color: #169388; font-size: 21rpx; margin-right: 18rpx; }
.logout { color: #7b8a96; background: transparent; font-size: 24rpx; font-weight: 400; margin-top: 20rpx; }
