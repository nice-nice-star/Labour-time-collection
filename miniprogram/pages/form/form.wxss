.form-page { padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }
.report-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; }
.report-heading .page-title { font-size: 40rpx; margin-bottom: 8rpx; }
.section-heading .helper { margin: 0; font-size: 21rpx; }
.input-unit { position: relative; }
.input-unit .input { padding-right: 90rpx; }
.unit { position: absolute; right: 24rpx; top: 24rpx; color: #7a8995; }
.location-option { display: flex; align-items: center; border: 2rpx solid #e6edf0; border-radius: 14rpx; padding: 20rpx; margin-bottom: 14rpx; font-size: 26rpx; }
.location-selected { border-color: #43a89a; background: #f0faf6; color: #137b71; }
.location-option radio { transform: scale(.85); margin-right: 12rpx; flex-shrink: 0; }
.table-heading { display: flex; justify-content: space-between; background: #f3f6f8; color: #7b8c96; font-size: 22rpx; padding: 16rpx; border-radius: 10rpx; }
.project-row { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #edf1f4; }
.project-row:last-child { border-bottom: none; padding-bottom: 0; }
.project-info { flex: 1; min-width: 0; padding-right: 20rpx; }
.project-title { display: block; font-size: 25rpx; }
.project-rate { display: block; font-size: 21rpx; color: #81909c; margin-top: 6rpx; }
.count-input { width: 108rpx; height: 76rpx; flex-shrink: 0; text-align: center; background: #f5f8fa; border: 2rpx solid #e1e9ed; border-radius: 12rpx; font-size: 29rpx; color: #147e75; }
.optional { color: #93a1aa; font-weight: 400; font-size: 23rpx; margin-left: 12rpx; }
.summary-card { background: #edf6f3; border-color: #d8eae3; }
.summary-grid { display: flex; margin: 24rpx 0; }
.summary-grid > view { flex: 1; }
.metric-label { display: block; font-size: 23rpx; color: #6a827f; }
.metric-value { font-size: 52rpx; font-weight: 600; }
.metric-unit { font-size: 24rpx; color: #7a8d94; font-weight: 400; }
.accent { color: #0d8277; }
.submit-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; padding: 20rpx 32rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e3ebee; background: #fff; z-index: 10; }
.submit-info { flex: 1; }
.submit-caption { display: block; font-size: 21rpx; color: #7a8995; }
.submit-total { font-size: 36rpx; font-weight: 600; color: #0e8177; }
.submit-bar .btn-primary { margin: 0; width: 340rpx; }
