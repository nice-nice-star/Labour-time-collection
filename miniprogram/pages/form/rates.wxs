// 表单模板用的费率查询。WXML 不能直接调用 Page 里的 JS 函数，只能通过 WXS，
// 所以这里保留一份「稳定键 → 参与/统筹工时」的最小表。
// 该表的值必须与 miniprogram/config/constants.js 的 PROJECT_HOURS 完全一致，
// 由 tests/workflow.test.js 的用例校验两者不会漂移。
var HOURS = {
  news_article: { participant: 1.5, coordinator: 5 },
  feature_interview: { participant: 3, coordinator: 10 },
  in_depth_report: { participant: 3, coordinator: 10 },
  social_post_copy: { participant: 1.5, coordinator: 5 },
  graphic_layout: { participant: 1, coordinator: 3 },
  poster: { participant: 1.5, coordinator: 5 },
  long_graphic: { participant: 1.5, coordinator: 5 },
  short_video_1min: { participant: 1.5, coordinator: 5 },
  short_video_3min: { participant: 3, coordinator: 10 },
  event_coverage: { participant: 5, coordinator: null },
  data_report: { participant: 3, coordinator: null },
  reception: { participant: null, coordinator: null },
  management_project: { participant: null, coordinator: null },
  team_activity: { participant: 3, coordinator: 10 }
}

// 「按实际」项目：没有固定费率，折算工时直接取学助填写的实际完成时间。
var ACTUAL = { reception: true, management_project: true }

function getHours(key) {
  return (key && HOURS[key]) || null
}

function isActual(key) {
  return ACTUAL[key] === true
}

/** 取费率；null 表示该项目该角色不计入工时 */
function rate(key, role) {
  var hours = getHours(key)
  if (!hours) return null
  var value = hours[role]
  return value === null || value === undefined ? null : value
}

/** 该项目是否开放统筹输入框 */
function hasCoordinator(key) {
  return rate(key, 'coordinator') !== null
}

/** 该项目是否没有固定费率且不计入（未知项目；「按实际」项目不算 pending） */
function isPending(key) {
  if (isActual(key)) return false
  return getHours(key) === null || (getHours(key).participant === null && getHours(key).coordinator === null)
}

/** 项目行下方的折算标准说明 */
function rateText(key) {
  if (isActual(key)) return '按实际 · 计入实际工时'
  if (isPending(key)) return '按实际 · 暂不计入'
  if (!hasCoordinator(key)) return '仅参与 ' + rate(key, 'participant') + ' 小时 / 个'
  return '统筹 ' + rate(key, 'coordinator') + ' h/个 · 参与 ' + rate(key, 'participant') + ' h/个'
}

module.exports = { rate: rate, hasCoordinator: hasCoordinator, isActual: isActual, isPending: isPending, rateText: rateText }
