<view class="page form-page">
  <view wx:if="{{loading}}" class="card state-card"><text class="state-title">{{t.loading}}</text><text class="helper">{{t.loadingHint}}</text></view>
  <view wx:elif="{{loadError}}" class="card state-card"><text class="state-title">{{t.unavailable}}</text><text class="helper">{{loadError}}</text><button class="btn-secondary" bindtap="loadForm">{{t.reload}}</button></view>
  <block wx:else>
    <view class="page-heading"><text class="eyebrow">MONTHLY REPORT</text><view class="report-heading"><text class="page-title">{{month}} {{t.report}}</text><text class="badge {{closed ? 'badge-muted' : ''}}">{{closed ? t.closed : t.open}}</text></view><text class="page-desc">{{t.deadline}} · {{deadline}}</text></view>
    <view wx:if="{{closed}}" class="notice">{{t.closedNotice}}</view>
    <view wx:elif="{{hasSubmission}}" class="notice">{{t.savedNotice}}</view>
    <view class="card">
      <view class="section-heading"><view><text class="section-index">01</text><text class="section-title">{{t.duty}}</text></view><text class="helper">{{t.basic}}</text></view>
      <text class="form-label field-first">{{t.dutyTotal}}</text>
      <view class="input-unit"><input class="input" type="digit" placeholder-class="placeholder" placeholder="{{t.dutyHint}}" value="{{dutyHours}}" bindinput="onDuty" disabled="{{closed || submitting}}" /><text class="unit">{{t.hours}}</text></view>
      <text class="form-label">{{t.shift}}</text><input class="input" placeholder-class="placeholder" placeholder="{{t.shiftHint}}" value="{{shiftTime}}" bindinput="onShift" disabled="{{closed || submitting}}" />
      <text class="form-label">{{t.location}}</text>
      <radio-group bindchange="onLocation"><label wx:for="{{locationOptions}}" wx:key="*this" class="location-option {{locationIndex === index ? 'location-selected' : ''}}"><radio color="#11877f" value="{{index}}" checked="{{locationIndex === index}}" disabled="{{closed || submitting}}" /><text>{{item}}</text></label></radio-group>
    </view>
    <view class="card">
      <view class="section-heading"><view><text class="section-index">02</text><text class="section-title">{{t.outputs}}</text></view><text class="helper">{{t.outputsHint}}</text></view>
      <view wx:if="{{legacyProjectRows.length}}" class="notice">{{t.legacyNotice}}<text wx:for="{{legacyProjectRows}}" wx:key="key" class="legacy-project">{{projectLabels[item.key] || item.label || item.key}}: {{t.coordinator}} {{item.counts.coordinator || 0}}, {{t.participant}} {{item.counts.participant || 0}}</text><text wx:if="{{projectName}}">{{t.originalName}}: {{projectName}}</text></view>
      <view class="project-entry" wx:for="{{projects}}" wx:key="localId" wx:for-item="project" wx:for-index="idx">
        <view class="project-entry-heading"><text class="section-title">{{t.project}} {{idx + 1}}</text><button class="remove-project" size="mini" data-idx="{{idx}}" bindtap="removeProject" wx:if="{{!closed}}" disabled="{{submitting}}">{{t.remove}}</button></view>
        <text class="form-label">{{t.type}}</text>
        <picker range="{{projectOptions}}" range-key="label" value="{{project.typeIndex}}" data-idx="{{idx}}" bindchange="onProjectType" disabled="{{closed || submitting}}"><view class="picker"><text>{{project.typeIndex >= 0 ? projectOptions[project.typeIndex].label : t.selectType}}</text><text class="chevron">⌄</text></view></picker>
        <text class="form-label">{{t.name}}</text><input class="input" value="{{project.name}}" placeholder="{{t.nameHint}}" data-idx="{{idx}}" data-field="name" bindinput="onProjectField" disabled="{{closed || submitting}}" />
        <text class="form-label">{{t.role}}</text><radio-group class="project-choices" data-idx="{{idx}}" data-field="role" bindchange="onProjectField"><label><radio value="coordinator" checked="{{project.role === 'coordinator'}}" disabled="{{closed || submitting}}" />{{t.lead}}</label><label><radio value="participant" checked="{{project.role === 'participant'}}" disabled="{{closed || submitting}}" />{{t.participant}}</label></radio-group>
        <text class="form-label">{{t.status}}</text><radio-group class="project-choices" data-idx="{{idx}}" data-field="status" bindchange="onProjectField"><label wx:for="{{statusOptions}}" wx:key="value"><radio value="{{item.value}}" checked="{{project.status === item.value}}" disabled="{{closed || submitting}}" />{{item.label}}</label></radio-group>
        <text class="form-label">{{t.completion}}</text><input class="input" value="{{project.completionForm}}" placeholder="{{t.completionHint}}" data-idx="{{idx}}" data-field="completionForm" bindinput="onProjectField" disabled="{{closed || submitting}}" />
        <text class="form-label">{{t.actual}}</text><view class="input-unit"><input class="input" type="digit" value="{{project.actualHours}}" placeholder="{{t.actualHint}}" data-idx="{{idx}}" data-field="actualHours" bindinput="onProjectField" disabled="{{closed || submitting}}" /><text class="unit">hrs</text></view>
      </view>
      <button class="btn-secondary" bindtap="addProject" wx:if="{{!closed}}" disabled="{{submitting}}">{{t.add}}</button>
      <text class="helper" wx:if="{{!projects.length}}">{{t.empty}}</text>
    </view>
    <view class="card">
      <view class="section-heading"><view><text class="section-index">03</text><text class="section-title">{{t.notes}}</text></view></view>
      <text class="form-label">{{t.appeal}} <text class="optional">{{t.optional}}</text></text><textarea class="textarea" placeholder-class="placeholder" placeholder="{{t.appealHint}}" maxlength="1000" value="{{appeal}}" bindinput="onAppeal" disabled="{{closed || submitting}}" /><text class="helper">{{t.appealHelp}}</text>
    </view>
    <view class="submit-bar" wx:if="{{!closed}}"><button class="btn-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? t.submitting : (hasSubmission ? t.update : t.submit)}}</button></view>
  </block>
</view>
