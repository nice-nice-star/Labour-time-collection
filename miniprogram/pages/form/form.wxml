<view class="page form-page">
  <view wx:if="{{loading}}" class="card state-card"><text class="state-title">正在读取月度表单</text><text class="helper">请稍候，正在同步你的填报记录。</text></view>
  <view wx:elif="{{loadError}}" class="card state-card"><text class="state-title">暂时无法填写</text><text class="helper">{{loadError}}</text><button class="btn-secondary" bindtap="loadForm">重新加载</button></view>
  <block wx:else>
    <view class="page-heading"><text class="eyebrow">MONTHLY REPORT</text><view class="report-heading"><text class="page-title">{{month}} 工时填报</text><text class="badge {{closed ? 'badge-muted' : ''}}">{{closed ? '已截止' : '填报中'}}</text></view><text class="page-desc">截止时间 · {{deadline}}</text></view>
    <view wx:if="{{closed}}" class="notice">本月填报已截止，以下为你的工时记录。</view>
    <view wx:elif="{{hasSubmission}}" class="notice">本月记录已提交。截止前可修改，再次提交后将更新记录。</view>
    <view class="card">
      <view class="section-heading"><view><text class="section-index">01</text><text class="section-title">值班记录</text></view><text class="helper">基础工时</text></view>
      <text class="form-label field-first">本月值班总工时</text>
      <view class="input-unit"><input class="input" type="digit" placeholder-class="placeholder" placeholder="例如 12.5" value="{{dutyHours}}" bindinput="onDuty" disabled="{{closed || submitting}}" /><text class="unit">小时</text></view>
      <text class="form-label">值班时段</text><input class="input" placeholder-class="placeholder" placeholder="例如 每周一 14:00–17:00" value="{{shiftTime}}" bindinput="onShift" disabled="{{closed || submitting}}" />
      <text class="form-label">值班地点</text>
      <radio-group bindchange="onLocation"><label wx:for="{{locationOptions}}" wx:key="*this" class="location-option {{locationIndex === index ? 'location-selected' : ''}}"><radio color="#11877f" value="{{index}}" checked="{{locationIndex === index}}" disabled="{{closed || submitting}}" /><text>{{item}}</text></label></radio-group>
    </view>
    <view class="card">
      <view class="section-heading"><view><text class="section-index">02</text><text class="section-title">项目产出</text></view><text class="helper">填写完成数量</text></view>
      <view class="table-heading"><text>产出项目 / 折算标准</text><text>数量</text></view>
      <view class="project-row" wx:for="{{projectRows}}" wx:key="item"><view class="project-info"><text class="project-title">{{item.item}}</text><text class="project-rate">{{item.hours === '待定' ? '工时待定 · 暂不计入' : item.hours + ' 小时 / 个'}}</text></view><input class="count-input" type="number" maxlength="6" value="{{item.count}}" data-idx="{{index}}" bindinput="onCount" disabled="{{closed || submitting}}" aria-label="{{item.item + '产出数量'}}" /></view>
    </view>
    <view class="card">
      <view class="section-heading"><view><text class="section-index">03</text><text class="section-title">补充说明</text></view></view>
      <text class="form-label field-first">参与的项目名称</text><input class="input" placeholder-class="placeholder" placeholder="填写项目名称，多个项目可用顿号分隔" value="{{projectName}}" bindinput="onProjectName" disabled="{{closed || submitting}}" />
      <text class="form-label">额外工时申诉 <text class="optional">选填</text></text><textarea class="textarea" placeholder-class="placeholder" placeholder="如有额外工时，请说明工作内容与时长" maxlength="1000" value="{{appeal}}" bindinput="onAppeal" disabled="{{closed || submitting}}" /><text class="helper">请提供清晰的说明，便于负责老师核对。</text>
    </view>
    <view class="card summary-card"><text class="section-title">工时预估</text><view class="summary-grid"><view><text class="metric-label">总工时</text><view><text class="metric-value">{{preview.totalHours}}</text><text class="metric-unit"> h</text></view></view><view><text class="metric-label">有效工时</text><view><text class="metric-value accent">{{preview.effectiveHours}}</text><text class="metric-unit"> h</text></view></view></view><text class="helper">按现有规则折算；学生主管总工时 × 1.5，有效工时最低为 40 小时。</text></view>
    <view class="submit-bar" wx:if="{{!closed}}"><view class="submit-info"><text class="submit-caption">预估有效工时</text><text class="submit-total">{{preview.effectiveHours}} <text class="metric-unit">h</text></text></view><button class="btn-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '正在提交' : (hasSubmission ? '更新本月记录' : '提交本月记录')}}</button></view>
  </block>
</view>
